  // Weight assumed for a product that has no `weightKg` of its own. Set to a
  // realistic figure for the catalogue: it is the only thing standing between a
  // legacy product and an unquotable checkout. Quotes that rely on it are marked
  // unverified so the fee can be reviewed against the courier invoice.
  defaultProductWeightKg Float   @default(0.5)
  // Flat delivery fee used when a courier quote cannot be obtained (no courier
  // configured, or a location the courier does not serve). Never a substitute
  // for a live quote where one is available.
  fallbackDeliveryFee   Decimal  @default(130)
  cartRecoveryDelayMins Int      @default(120)
  signupBonusCoins      Int      @default(100)
  dailyLoginBaseCoins   Int      @default(10)
  dailyLoginMaxCoins    Int      @default(70)
  orderCashbackBps      Int      @default(200)
  referralInviterCoins  Int      @default(150)
