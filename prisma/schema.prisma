  surpriseRewardChance  Float    @default(0.15)
  spinEnabled           Boolean  @default(true)
  spinDailyLimit        Int      @default(1)
  updatedById           String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  tenant    Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  updatedBy User?  @relation("TenantSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  @@schema("public")
}

