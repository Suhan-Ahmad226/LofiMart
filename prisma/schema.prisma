generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// Commerce OS domain baseline.
// This schema prepares the platform for multi-tenant commerce, payments, inventory,
// accounting, sessions, auditability, and vendor-ready store isolation.

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String?
  passwordHash  String
  phone         String?
  alternatePhone String?
  role          String   @default("customer")
  sellerStatus  String   @default("draft")
  submittedForReviewAt DateTime?
  approvedAt    DateTime?
  approvedById  String?
  rejectionReason String?
  suspensionReason String?
  avatarUrl     String?
  bio           String?
  storeName     String?
  storefrontSlug String?  @unique
  storefrontBannerUrl String?
  storefrontHeadline String?
  storefrontAccentColor String?
  storefrontCustomDomain String? @unique
  storefrontPublished Boolean @default(true)
  storefrontDomainStatus String? @default("unverified")
  storefrontDomainVerificationToken String?
  storefrontDomainVerifiedAt DateTime?
  profileVisibility String @default("private")
  responseTimeHours Int?
  twoFactorEnabled Boolean @default(false)
  phoneVerified Boolean @default(false)
  phoneVerifiedAt DateTime?
  isBlocked     Boolean  @default(false)
  blockedAt     DateTime?
  blockedReason String?
  deactivatedAt DateTime?
  points        Int      @default(0)
  walletBalance Decimal  @default(0)
  emailVerified Boolean  @default(false)
  emailVerifiedAt DateTime?
  tenantId      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  orders        Order[]
  orderShipments OrderShipment[]
  products      Product[] @relation("SellerProducts")
  warehouses    Warehouse[] @relation("WarehouseManager")
  sessions      Session[]
  auditLogs     AuditLog[]
  invoices      Invoice[]
  addresses     Address[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  passwordResets PasswordResetToken[]
  emailVerifications EmailVerificationToken[]
  phoneVerifications PhoneVerificationToken[]
  blogPosts     BlogPost[]
  pushSubscriptions PushSubscription[]
  resellerMarkups ResellerMarkup[] @relation("ResellerMarkups")
  resellerCommissions ResellerCommission[] @relation("ResellerCommissions")
  resellerReferrals ResellerReferral[] @relation("ResellerReferrals")
  resellerPayouts ResellerPayout[] @relation("ResellerPayouts")
  interactions UserInteraction[]
  recommendationAnalytics RecommendationAnalytic[]
  notificationPreference NotificationPreference?
  payoutMethods PayoutMethod[]
  payoutTransactions PayoutTransaction[]
  verificationSubmission VerificationSubmission?
  loginActivities LoginActivity[]
  accountActionRequests AccountActionRequest[] @relation("AccountActionRequests")
  processedActionRequests AccountActionRequest[] @relation("ProcessedAccountActionRequests")
  reviewedVerificationSubmissions VerificationSubmission[] @relation("VerificationReviewedBy")
  createdRiskFlags UserRiskFlag[] @relation("RiskFlagsCreatedBy")
  riskFlags UserRiskFlag[] @relation("RiskFlagsForUser")
  tenantMemberships TenantMembership[]
  tenantInvites TenantMembership[] @relation("TenantMembershipInvitedBy")
  tenantSettingsManaged TenantSetting[] @relation("TenantSettingUpdatedBy")
  walletTransactions WalletTransaction[]
  rewardLogs RewardLog[]
  referralCodes ReferralCode[] @relation("ReferralCodes")
  sentReferralAttributions ReferralAttribution[] @relation("ReferralInviter")
  receivedReferralAttributions ReferralAttribution[] @relation("ReferralInvitee")
  loginStreak LoginStreak?
  spinHistory SpinHistory[]
  missionProgress MissionProgress[]
  notifications UserNotification[]
  adminNotificationsCreated UserNotification[] @relation("NotificationCreatedBy")
  communityPosts CommunityPost[] @relation("CommunityPostsByUser")
  moderatedCommunityPosts CommunityPost[] @relation("CommunityPostsModeratedBy")
  communityComments CommunityPostComment[] @relation("CommunityCommentsByUser")
  moderatedCommunityComments CommunityPostComment[] @relation("CommunityCommentsModeratedBy")
  communityPostLikes CommunityPostLike[]
  communityPostReports CommunityPostReport[] @relation("CommunityPostReportsByUser")
  moderatedCommunityPostReports CommunityPostReport[] @relation("CommunityPostReportsModeratedBy")
  flashSaleCampaigns FlashSaleCampaign[] @relation("FlashSaleCampaignsCreatedBy")
  flashSaleEntries FlashSaleEntry[] @relation("FlashSaleEntriesBySeller")
  reviewedFlashSaleEntries FlashSaleEntry[] @relation("FlashSaleEntryReviewedBy")
  coupons       Coupon[] @relation("SellerCoupons")
  approvedBy    User?    @relation("SellerApprovedBy", fields: [approvedById], references: [id])
  approvedSellers User[] @relation("SellerApprovedBy")

  @@schema("public")
}

model Product {
  id           String   @id @default(cuid())
  sku          String?  @unique
  name         String
  slug         String   @unique
  description  String?
  specifications Json?
  price        Decimal
  oldPrice     Decimal?
  image        String?
  galleryImages Json?
  videoUrl     String?
  model3d      String?
  category     String?
  variantOptions Json?
  resellerEnabled Boolean @default(false)
  resellerBasePrice Decimal?
  resellerSuggestedPrice Decimal?
  resellerNotes String?
  productStatus String @default("draft")
  publishedAt  DateTime?
  stock        Int      @default(0)
  tenantId     String?
  rating       Float    @default(0)
  reviewsCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant       Tenant?  @relation(fields: [tenantId], references: [id])
  sellerId     String?
  seller       User?    @relation("SellerProducts", fields: [sellerId], references: [id])

  orderItems   OrderItem[]
  inventoryItems InventoryItem[]
  reservations StockReservation[]
  purchaseOrderLines PurchaseOrderLine[]
  inventoryMovements InventoryMovement[]
  shipmentItems OrderShipmentItem[]
  reviews      Review[]
  wishlistItems WishlistItem[]
  resellerMarkups ResellerMarkup[]
  resellerCommissions ResellerCommission[]
  interactions UserInteraction[]
  recommendationAnalytics RecommendationAnalytic[]
  priceHistory PriceHistory[]
  pricingSuggestions PricingSuggestion[]
  communityPosts CommunityPost[]
  flashSaleEntries FlashSaleEntry[]

  @@schema("public")
}

model Order {
  id            String   @id @default(cuid())
  orderCode     String?  @unique
  userId        String
  tenantId      String?
  total         Decimal
  status        String   @default("processing")
  courierProvider String?
  trackingId    String?
  paymentMethod String?
  paymentProvider String?
  paymentIntentId String?
  paymentStatus String?
  paidAt       DateTime?
  pickupRequestedAt DateTime?
  pickedUpAt   DateTime?
  outForDeliveryAt DateTime?
  deliveredAt  DateTime?
  failureReason String?
  deliveryFailureReason String?
  refCode      String?
  shippingAddress Json?
  shipmentMetadata Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant        Tenant?  @relation(fields: [tenantId], references: [id])
  user          User     @relation(fields: [userId], references: [id])
  items         OrderItem[]
  shipments     OrderShipment[]
  transactions  PaymentTransaction[]
  invoice       Invoice?
  resellerCommissions ResellerCommission[]
  referralAttributions ReferralAttribution[]

  @@schema("public")
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  productId String
  qty       Int     @default(1)
  price     Decimal
  variantSummary String?
  variantSku String?

  order     Order   @relation(fields: [orderId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
  shipmentItems OrderShipmentItem[]

  @@schema("public")
}

model OrderShipment {
  id                    String   @id @default(cuid())
  orderId               String
  sellerId              String
  warehouseId           String?
  status                String   @default("processing")
  total                 Decimal
  itemCount             Int      @default(0)
  courierProvider       String?
  trackingId            String?
  pickupRequestedAt     DateTime?
  pickedUpAt            DateTime?
  outForDeliveryAt      DateTime?
  deliveredAt           DateTime?
  deliveryFailureReason String?
  shipmentMetadata      Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller                User      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouse             Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items                 OrderShipmentItem[]

  @@index([orderId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([warehouseId, status, createdAt])
  @@schema("public")
}

model OrderShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderItemId String
  productId   String
  qty         Int      @default(1)
  price       Decimal
  createdAt   DateTime @default(now())

  shipment    OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem    OrderItem    @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderItemId])
  @@index([shipmentId, createdAt])
  @@index([productId])
  @@schema("public")
}

model Warehouse {
  id          String          @id @default(cuid())
  name        String
  tenantId    String?
  address     String
  city        String
  state       String?
  country     String
  postalCode  String
  phone       String?
  email       String?
  contactName String?
  secondaryContact String?
  otpNumber   String?
  pathaoStoreId Int?
  pathaoCityId Int?
  pathaoZoneId Int?
  pathaoAreaId Int?
  insideDhakaFee Decimal?
  outsideDhakaFee Decimal?
  insideDhakaEta String?
  outsideDhakaEta String?
  freeShippingThresholdOverride Decimal?
  maxItems    Int?
  maxWeightKg Float?
  managerId   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant         Tenant?       @relation(fields: [tenantId], references: [id])
  manager        User?         @relation("WarehouseManager", fields: [managerId], references: [id])
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  stockReservations StockReservation[]
  shipments      OrderShipment[]

  @@schema("public")
}

model InventoryItem {
  id             String   @id @default(cuid())
  productId      String
  warehouseId    String
  quantity       Int      @default(0)
  reserved       Int      @default(0)
  reorderLevel   Int      @default(5)
  restockThreshold Int?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  product        Product   @relation(fields: [productId], references: [id])
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  movements      InventoryMovement[]
  reservations   StockReservation[]

  @@unique([productId, warehouseId])

  @@schema("public")
}

model Tenant {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  products    Product[]
  orders      Order[]
  warehouses  Warehouse[]
  stores      Store[]
  memberships TenantMembership[]
  settings    TenantSetting?
  walletTransactions WalletTransaction[]
  rewardLogs  RewardLog[]
  referralCodes ReferralCode[]
  spinRewards SpinReward[]
  spinHistory SpinHistory[]
  missions    Mission[]
  notifications UserNotification[]
  communityPosts CommunityPost[]

  @@schema("public")
}

model Store {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  domain      String?  @unique
  currency    String   @default("USD")
  locale      String   @default("en")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant      Tenant   @relation(fields: [tenantId], references: [id])

  @@schema("public")
}

model Category {
  id           String   @id @default(cuid())
  name         String
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  subcategories Subcategory[]

  @@schema("public")
}

model Subcategory {
  id           String   @id @default(cuid())
  categoryId   String
  name         String
  icon         String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subsubcategories Subsubcategory[]

  @@schema("public")
}

model Subsubcategory {
  id            String   @id @default(cuid())
  subcategoryId String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Session {
  id          String   @id @default(cuid())
  userId      String
  tokenHash   String   @unique
  deviceName  String?
  ipAddress   String?
  location    String?
  userAgent   String?
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id])

  @@schema("public")
}

model PasswordResetToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model EmailVerificationToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id])

  @@schema("public")
}

model InventoryMovement {
  id              String   @id @default(cuid())
  inventoryItemId String
  productId       String
  warehouseId     String
  type            String
  quantityDelta   Int
  reason          String
  reference       String?
  createdAt       DateTime @default(now())

  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])

  @@schema("public")
}

model StockReservation {
  id              String   @id @default(cuid())
  productId       String
  warehouseId     String
  inventoryItemId String
  orderId         String?
  quantity        Int
  status          String   @default("reserved")
  expiresAt       DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product         Product       @relation(fields: [productId], references: [id])
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@schema("public")
}

model PurchaseOrder {
  id            String   @id @default(cuid())
  warehouseId   String
  supplierName  String
  status        String   @default("draft")
  currency      String   @default("USD")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  warehouse     Warehouse @relation(fields: [warehouseId], references: [id])
  lines         PurchaseOrderLine[]

  @@schema("public")
}

model PurchaseOrderLine {
  id              String   @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal

  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])

  @@schema("public")
}

model PaymentTransaction {
  id             String   @id @default(cuid())
  provider       String
  paymentId      String   @unique
  orderId        String?
  customerId     String?
  amount         Decimal
  currency       String
  status         String
  idempotencyKey String   @unique
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order          Order?   @relation(fields: [orderId], references: [id])
  refunds        Refund[]

  @@schema("public")
}

model Refund {
  id               String   @id @default(cuid())
  transactionId    String
  providerRefundId String   @unique
  amount           Decimal
  reason           String?
  status           String
  createdAt        DateTime @default(now())

  transaction      PaymentTransaction @relation(fields: [transactionId], references: [id])

  @@schema("public")
}

model Review {
  id          String   @id @default(cuid())
  productId   String
  userId      String
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model WishlistItem {
  id          String   @id @default(cuid())
  userId      String
  productId   String
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])

  @@schema("public")
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  label       String?
  type        String   @default("shipping")
  name        String
  phone       String
  alternatePhone String?
  address     String
  line2       String?
  division    String?
  district    String?
  upazila     String?
  house       String?
  road        String?
  village     String?
  city        String
  state       String?
  postalCode  String?
  country     String   @default("Bangladesh")
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model Coupon {
  id              String   @id @default(cuid())
  code            String   @unique
  sellerId        String?
  discountType    String
  discountValue   Decimal
  minOrderValue   Decimal  @default(0)
  expiryDate      DateTime
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  seller          User?    @relation("SellerCoupons", fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, expiryDate])
  @@schema("public")
}

model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  category    String?
  content     String
  image       String?
  seoTitle    String?
  seoDescription String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  subject     String
  message     String
  status      String   @default("unread")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

model Banner {
  id          String   @id @default(cuid())
  title       String
  subtitle    String?
  image       String
  link        String
  buttonText  String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

model PlatformSetting {
  key         String   @id
  value       String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@schema("public")
}

model PushSubscription {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String   @unique
  data        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model CommunityPost {
  id             String   @id @default(cuid())
  userId         String
  tenantId       String?
  productId      String?
  title          String?
  content        String
  imageUrl       String?
  topic          String?
  status         String   @default("pending")
  likesCount     Int      @default(0)
  commentsCount  Int      @default(0)
  moderationNote String?
  moderatedAt    DateTime?
  moderatedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user           User     @relation("CommunityPostsByUser", fields: [userId], references: [id], onDelete: Cascade)
  tenant         Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  product        Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  moderatedBy    User?    @relation("CommunityPostsModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)
  comments       CommunityPostComment[]
  likes          CommunityPostLike[]
  reports        CommunityPostReport[]

  @@index([status, createdAt])
  @@index([tenantId, status, createdAt])
  @@index([userId, createdAt])
  @@schema("public")
}

model CommunityPostComment {
  id             String   @id @default(cuid())
  postId         String
  userId         String
  content        String
  status         String   @default("visible")
  moderationNote String?
  moderatedAt    DateTime?
  moderatedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post           CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User          @relation("CommunityCommentsByUser", fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy    User?         @relation("CommunityCommentsModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@index([postId, status, createdAt])
  @@index([userId, createdAt])
  @@schema("public")
}

model CommunityPostLike {
  id          String   @id @default(cuid())
  postId      String
  userId      String
  createdAt   DateTime @default(now())

  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([userId, createdAt])
  @@schema("public")
}

model CommunityPostReport {
  id             String   @id @default(cuid())
  postId         String
  userId         String
  reason         String
  details        String?
  status         String   @default("open")
  moderatedAt    DateTime?
  moderatedById  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  post           CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User          @relation("CommunityPostReportsByUser", fields: [userId], references: [id], onDelete: Cascade)
  moderatedBy    User?         @relation("CommunityPostReportsModeratedBy", fields: [moderatedById], references: [id], onDelete: SetNull)

  @@unique([postId, userId])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@schema("public")
}

model PhoneVerificationToken {
  id          String   @id @default(cuid())
  userId      String
  token       String   @unique
  expiresAt   DateTime
  used        Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model FlashSaleCampaign {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  bannerImage String?
  startsAt    DateTime
  endsAt      DateTime
  status      String   @default("draft")
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy   User?    @relation("FlashSaleCampaignsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  entries     FlashSaleEntry[]

  @@index([status, startsAt, endsAt])
  @@schema("public")
}

model FlashSaleEntry {
  id              String   @id @default(cuid())
  campaignId      String
  sellerId        String
  productId       String
  salePrice       Decimal
  allocatedStock  Int      @default(0)
  status          String   @default("pending")
  note            String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  campaign        FlashSaleCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  seller          User              @relation("FlashSaleEntriesBySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  product         Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("FlashSaleEntryReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@unique([campaignId, productId])
  @@index([sellerId, status, createdAt])
  @@index([campaignId, status, createdAt])
  @@schema("public")
}

model TenantMembership {
