  businessLicenseUrl String?
  notes              String?
  rejectionReason    String?
  riskScore          Float     @default(0)
  submittedAt        DateTime  @default(now())
  reviewedAt         DateTime?
  reviewedById       String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user       User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy User?                  @relation("VerificationReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  documents  VerificationDocument[]

  @@schema("public")
}

model VerificationDocument {
  id             String   @id @default(cuid())
  verificationId String
  type           String
  label          String
  url            String
  publicId       String?
  mimeType       String?
  sizeBytes      Int?
  createdAt      DateTime @default(now())

  verification VerificationSubmission @relation(fields: [verificationId], references: [id], onDelete: Cascade)

  @@index([verificationId])
  @@schema("public")
}

model MediaAsset {
  id           String    @id @default(cuid())
  url          String
  publicId     String
  resourceType String    @default("image")
  ownerType    String
  ownerId      String
  entityType   String?
  entityId     String?
  fieldName    String?
  status       String    @default("active")
  bytes        Int?
  format       String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@unique([publicId, resourceType])
  @@index([ownerType, ownerId])
  @@index([entityType, entityId])
  @@index([status, createdAt])
  @@schema("public")
}

model PayoutMethod {
  id                     String   @id @default(cuid())
  userId                 String
  type                   String
  provider               String
  accountName            String?
  encryptedAccountNumber String?
  encryptedRoutingNumber String?
  encryptedMobileNumber  String?
  accountLast4           String?
  isDefault              Boolean  @default(false)
  status                 String   @default("active")
  metadata               Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutTransactions PayoutTransaction[]

  @@schema("public")
}

model PayoutTransaction {
  id             String    @id @default(cuid())
  userId         String
  payoutMethodId String?
  type           String
  amount         Decimal
  currency       String    @default("BDT")
  status         String    @default("pending")
  reference      String?
  notes          String?
  metadata       Json?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutMethod PayoutMethod? @relation(fields: [payoutMethodId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([payoutMethodId])
  @@schema("public")
}

model LoginActivity {
  id         String    @id @default(cuid())
  userId     String
  sessionId  String
  ipAddress  String?
  userAgent  String?
  deviceName String?
  location   String?
  loggedInAt DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, sessionId])
  @@schema("public")
}

model AccountActionRequest {
  id             String    @id @default(cuid())
  userId         String
  orderId        String?
  type           String
  status         String    @default("pending")
  reason         String?
  resolutionNote String?
  processedById  String?
  processedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user        User  @relation("AccountActionRequests", fields: [userId], references: [id], onDelete: Cascade)
  processedBy User? @relation("ProcessedAccountActionRequests", fields: [processedById], references: [id], onDelete: SetNull)

  @@index([orderId, type, status])
  @@index([processedById])
  @@schema("public")
}

model UserRiskFlag {
  id          String    @id @default(cuid())
  userId      String
  createdById String?
  severity    String    @default("medium")
  reason      String
  notes       String?
  isActive    Boolean   @default(true)
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User  @relation("RiskFlagsForUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User? @relation("RiskFlagsCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([createdById])
  @@schema("public")
}

model ResellerMarkup {
  id           String   @id @default(cuid())
  resellerId   String
  productId    String
  markupAmount Decimal
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reseller User    @relation("ResellerMarkups", fields: [resellerId], references: [id], onDelete: Cascade)
  product  Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([resellerId, productId])
  @@schema("public")
}

model ResellerCommission {
  id         String    @id @default(cuid())
  resellerId String
  orderId    String?
  productId  String?
  amount     Decimal
  status     String    @default("pending")
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reseller User     @relation("ResellerCommissions", fields: [resellerId], references: [id], onDelete: Cascade)
  order    Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
  product  Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([resellerId, orderId, productId])
  @@index([resellerId, orderId, productId])
  @@schema("public")
}

model ResellerReferral {
  id         String   @id @default(cuid())
  resellerId String
  code       String   @unique
  clicks     Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  reseller User @relation("ResellerReferrals", fields: [resellerId], references: [id], onDelete: Cascade)

  @@unique([resellerId])
  @@schema("public")
}

model ResellerPayout {
  id         String    @id @default(cuid())
  resellerId String
  amount     Decimal
  status     String    @default("pending")
  notes      String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  reseller User @relation("ResellerPayouts", fields: [resellerId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model UserInteraction {
  id              String   @id @default(cuid())
  userId          String?
  productId       String
  interactionType String
  sessionId       String?
  deviceType      String?
  createdAt       DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model RecommendationAnalytic {
  id               String   @id @default(cuid())
  recommendationId String
  userId           String?
  productId        String
  position         Int?
  clicked          Boolean  @default(false)
  converted        Boolean  @default(false)
  createdAt        DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model PriceHistory {
  id               String   @id @default(cuid())
  productId        String
  price            Decimal
  competitorPrices Json?
  demandScore      Float?
  conversionRate   Float?
  createdAt        DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model PricingSuggestion {
  id              String   @id @default(cuid())
  productId       String
  suggestedPrice  Decimal
  minPrice        Decimal?
  maxPrice        Decimal?
  confidenceScore Float?
  reasons         Json?
  applied         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model LedgerAccount {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  type      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@schema("public")
}

model JournalEntry {
  id        String   @id @default(cuid())
  reference String   @unique
  memo      String?
  currency  String   @default("USD")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines JournalLine[]

  @@schema("public")
}

model JournalLine {
  id             String  @id @default(cuid())
  journalEntryId String
  accountId      String
  debit          Decimal @default(0)
  credit         Decimal @default(0)
  description    String?

  journalEntry JournalEntry  @relation(fields: [journalEntryId], references: [id])
  account      LedgerAccount @relation(fields: [accountId], references: [id])

  @@schema("public")
}

model Invoice {
  id          String    @id @default(cuid())
  orderId     String    @unique
  userId      String?
  status      String    @default("draft")
  invoiceUrl  String?
  documentUrl String?
  subtotal    Decimal
  tax         Decimal   @default(0)
  total       Decimal
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  order Order @relation(fields: [orderId], references: [id])
  user  User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@schema("public")
}

model Expense {
  id         String   @id @default(cuid())
  category   String
  amount     Decimal
  vendor     String?
  notes      String?
  incurredAt DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@schema("public")
}
