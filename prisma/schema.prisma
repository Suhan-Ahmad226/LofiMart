generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

// Commerce OS domain baseline.
// This schema prepares the platform for multi-tenant commerce, payments, inventory,
// accounting, sessions, auditability, and vendor-ready store isolation.

enum UserRole {
  customer
  seller
  reseller
  admin

  @@schema("public")
}

enum OrderStatus {
  pending
  processing
  packed
  ready_for_pickup
  pickup_requested
  picked_up
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned
  cancelled

  @@schema("public")
  shipped
}

enum PaymentStatus {
  pending
  paid
  failed
  refunded
  partially_refunded
  // Legacy live rows may still contain this value; keep it readable until the data is normalized.
  unpaid

  @@schema("public")
}

enum ShipmentStatus {
  pending
  processing
  packed
  ready_for_pickup
  pickup_requested
  picked_up
  in_transit
  out_for_delivery
  delivered
  delivery_failed
  returned
  cancelled

  @@schema("public")
  shipped
}

enum SocialPlatform {
  facebook

  @@schema("public")
}

enum SocialAccountStatus {
  CONNECTED
  DISCONNECTED
  EXPIRED
  ERROR

  @@schema("public")
}

enum SocialPostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED

  @@schema("public")
}

enum SocialAutomationStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  FAILED

  @@schema("public")
}

enum SocialAutomationRunStatus {
  PENDING
  CLAIMED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED

  @@schema("public")
}

model User {
  id                                String    @id @default(cuid())
  email                             String    @unique
  supabaseAuthId                    String?   @unique
  name                              String?
  phone                             String?   @unique
  alternatePhone                    String?
  role                              UserRole  @default(customer)
  sellerStatus                      String    @default("draft")
  submittedForReviewAt              DateTime?
  approvedAt                        DateTime?
  approvedById                      String?
  rejectionReason                   String?
  suspensionReason                  String?
  avatarUrl                         String?
  bio                               String?
  storeName                         String?
  storefrontSlug                    String?   @unique
  storefrontBannerUrl               String?
  storefrontHeadline                String?
  storefrontAccentColor             String?
  storefrontCustomDomain            String?   @unique
  storefrontPublished               Boolean   @default(true)
  storefrontDomainStatus            String?   @default("unverified")
  storefrontDomainVerificationToken String?
  storefrontDomainVerifiedAt        DateTime?
  profileVisibility                 String    @default("private")
  responseTimeHours                 Int?
  telegramChatId                    String?   @unique
  telegramLinkedAt                  DateTime?
  twoFactorEnabled                  Boolean   @default(false)
  phoneVerified                     Boolean   @default(false)
  phoneVerifiedAt                   DateTime?
  isBlocked                         Boolean   @default(false)
  blockedAt                         DateTime?
  blockedReason                     String?
  deactivatedAt                     DateTime?
  points                            Int       @default(0)
  walletBalance                     Decimal   @default(0)
  emailVerified                     Boolean   @default(false)
  emailVerifiedAt                   DateTime?
  tenantId                          String?
  refCode                           String?   @unique @db.VarChar(20)
  referral                          String?   @db.VarChar(255)
  createdAt                         DateTime  @default(now())
  updatedAt                         DateTime  @updatedAt

  tenant                          Tenant?                  @relation(fields: [tenantId], references: [id])
  orders                          Order[]
  orderShipments                  OrderShipment[]
  products                        Product[]                @relation("SellerProducts")
  warehouses                      Warehouse[]              @relation("WarehouseManager")
  auditLogs                       AuditLog[]
  invoices                        Invoice[]
  addresses                       Address[]
  reviews                         Review[]
  wishlistItems                   WishlistItem[]
  emailVerifications              EmailVerificationToken[]
  phoneVerifications              PhoneVerificationToken[]
  blogPosts                       BlogPost[]
  pushSubscriptions               PushSubscription[]
  resellerMarkups                 ResellerMarkup[]         @relation("ResellerMarkups")
  resellerCommissions             ResellerCommission[]     @relation("ResellerCommissions")
  resellerReferrals               ResellerReferral[]       @relation("ResellerReferrals")
  resellerPayouts                 ResellerPayout[]         @relation("ResellerPayouts")
  paymentTransactions             PaymentTransaction[]     @relation("PaymentTransactions")
  interactions                    UserInteraction[]
  recommendationAnalytics         RecommendationAnalytic[]
  notificationPreference          NotificationPreference?
  payoutMethods                   PayoutMethod[]
  payoutTransactions              PayoutTransaction[]
  verificationSubmission          VerificationSubmission?
  loginActivities                 LoginActivity[]
  accountActionRequests           AccountActionRequest[]   @relation("AccountActionRequests")
  processedActionRequests         AccountActionRequest[]   @relation("ProcessedAccountActionRequests")
  reviewedVerificationSubmissions VerificationSubmission[] @relation("VerificationReviewedBy")
  createdRiskFlags                UserRiskFlag[]           @relation("RiskFlagsCreatedBy")
  riskFlags                       UserRiskFlag[]           @relation("RiskFlagsForUser")
  tenantMemberships               TenantMembership[]
  tenantInvites                   TenantMembership[]       @relation("TenantMembershipInvitedBy")
  tenantSettingsManaged           TenantSetting[]          @relation("TenantSettingUpdatedBy")
  walletTransactions              WalletTransaction[]
  rewardLogs                      RewardLog[]
  referralCodes                   ReferralCode[]           @relation("ReferralCodes")
  sentReferralAttributions        ReferralAttribution[]    @relation("ReferralInviter")
  receivedReferralAttributions    ReferralAttribution[]    @relation("ReferralInvitee")
  loginStreak                     LoginStreak?
  spinHistory                     SpinHistory[]
  missionProgress                 MissionProgress[]
  notifications                   UserNotification[]
  adminNotificationsCreated       UserNotification[]       @relation("NotificationCreatedBy")
  communityPosts                  CommunityPost[]          @relation("CommunityPostsByUser")
  moderatedCommunityPosts         CommunityPost[]          @relation("CommunityPostsModeratedBy")
  communityComments               CommunityPostComment[]   @relation("CommunityCommentsByUser")
  moderatedCommunityComments      CommunityPostComment[]   @relation("CommunityCommentsModeratedBy")
  communityPostLikes              CommunityPostLike[]
  communityPostReports            CommunityPostReport[]    @relation("CommunityPostReportsByUser")
  moderatedCommunityPostReports   CommunityPostReport[]    @relation("CommunityPostReportsModeratedBy")
  flashSaleCampaigns              FlashSaleCampaign[]      @relation("FlashSaleCampaignsCreatedBy")
  flashSaleEntries                FlashSaleEntry[]         @relation("FlashSaleEntriesBySeller")
  reviewedFlashSaleEntries        FlashSaleEntry[]         @relation("FlashSaleEntryReviewedBy")
  coupons                         Coupon[]                 @relation("SellerCoupons")
  socialAccounts                  SocialAccount[]          @relation("SellerSocialAccounts")
  socialAutomationSettings        SocialAutomationSetting?
  socialPosts                     SocialPost[]             @relation("SellerSocialPosts")
  socialPostAutomations           SocialPostAutomation[]   @relation("SellerSocialPostAutomations")
  socialAutomationRuns            SocialAutomationRun[]    @relation("SellerSocialAutomationRuns")
  oauthStates                     OAuthState[]             @relation("SellerOAuthStates")
  providerAccounts                ProviderAccount[]
  approvedBy                      User?                    @relation("SellerApprovedBy", fields: [approvedById], references: [id])
  approvedSellers                 User[]                   @relation("SellerApprovedBy")

  @@schema("public")
}

model Product {
  id                     String    @id @default(cuid())
  sku                    String?   @unique
  name                   String
  slug                   String    @unique
  description            String?
  specifications         Json?
  price                  Decimal
  oldPrice               Decimal?
  // Shipping weight per unit, in kilograms. Required for a real courier quote:
  // the courier prices by weight, so a product without one can only be quoted
  // from `TenantSetting.defaultProductWeightKg` and the resulting quote is
  // flagged unverified. Null rather than 0 so "not set" stays distinguishable
  // from "weighs nothing".
  weightKg               Float?
  image                  String?
  galleryImages          Json?
  videoUrl               String?
  model3d                String?
  category               String?
  variantOptions         Json?
  resellerEnabled        Boolean   @default(false)
  resellerBasePrice      Decimal?
  resellerSuggestedPrice Decimal?
  resellerNotes          String?
  productStatus          String    @default("draft")
  publishedAt            DateTime?
  stock                  Int       @default(0)
  tenantId               String?
  rating                 Float     @default(0)
  reviewsCount           Int       @default(0)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  tenant   Tenant? @relation(fields: [tenantId], references: [id])
  sellerId String?
  seller   User?   @relation("SellerProducts", fields: [sellerId], references: [id])

  orderItems              OrderItem[]
  inventoryItems          InventoryItem[]
  reservations            StockReservation[]
  purchaseOrderLines      PurchaseOrderLine[]
  inventoryMovements      InventoryMovement[]
  shipmentItems           OrderShipmentItem[]
  reviews                 Review[]
  wishlistItems           WishlistItem[]
  resellerMarkups         ResellerMarkup[]
  resellerCommissions     ResellerCommission[]
  interactions            UserInteraction[]
  recommendationAnalytics RecommendationAnalytic[]
  priceHistory            PriceHistory[]
  pricingSuggestions      PricingSuggestion[]
  communityPosts          CommunityPost[]
  flashSaleEntries        FlashSaleEntry[]
  socialPosts             SocialPost[]
  socialPostAutomations   SocialPostAutomation[]
  socialAutomationRuns    SocialAutomationRun[]

  @@index([sellerId])
  @@index([category])
  @@index([productStatus, publishedAt])
  @@index([createdAt])
  @@index([rating])
  @@schema("public")
}

model Order {
  id                    String         @id @default(cuid())
  orderCode             String?        @unique
  userId                String?
  guestEmail            String?
  guestPhone            String?
  claimedAt             DateTime?
  tenantId              String?
  total                 Decimal
  status                OrderStatus    @default(processing)
  courierProvider       String?
  trackingId            String?
  paymentMethod         String?
  paymentProvider       String?
  paymentStatus         PaymentStatus?
  paidAt                DateTime?
  pickupRequestedAt     DateTime?
  pickedUpAt            DateTime?
  outForDeliveryAt      DateTime?
  deliveredAt           DateTime?
  failureReason         String?
  deliveryFailureReason String?
  refCode               String?
  shippingAddress       Json?
  shipmentMetadata      Json?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  tenant               Tenant?               @relation(fields: [tenantId], references: [id])
  user                 User?                 @relation(fields: [userId], references: [id])
  items                OrderItem[]
  shipments            OrderShipment[]
  transactions         PaymentTransaction[]
  invoice              Invoice?
  resellerCommissions  ResellerCommission[]
  referralAttributions ReferralAttribution[]
  stockReservations    StockReservation[]

  @@index([userId])
  @@index([guestEmail])
  @@index([status])
  @@index([status, createdAt])
  @@index([tenantId])
  @@index([paymentStatus])
  @@schema("public")
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  productId      String
  qty            Int     @default(1)
  price          Decimal
  variantSummary String?
  variantSku     String?

  order         Order               @relation(fields: [orderId], references: [id])
  product       Product             @relation(fields: [productId], references: [id])
  shipmentItems OrderShipmentItem[]

  @@index([orderId])
  @@index([productId])
  @@schema("public")
}

model OrderShipment {
  id                    String         @id @default(cuid())
  orderId               String
  sellerId              String
  warehouseId           String?
  status                ShipmentStatus @default(processing)
  total                 Decimal
  itemCount             Int            @default(0)
  courierProvider       String?
  trackingId            String?
  pickupRequestedAt     DateTime?
  pickedUpAt            DateTime?
  outForDeliveryAt      DateTime?
  deliveredAt           DateTime?
  deliveryFailureReason String?
  shipmentMetadata      Json?

  // --- Generic courier identity (no provider-specific columns) ---
  // Stable provider-side idempotency key. Generated once per shipment and
  // reused across every retry so a retried booking cannot create a second
  // physical parcel.
  merchantReference String?
  // Whatever the provider echoes back, when it echoes anything.
  providerReference String?
  // The provider's raw status string, kept for audit. Never read as app state.
  providerStatus String?

  // --- Financial separation ---
  // What the customer was charged for delivery, frozen when the order was made.
  customerDeliveryFee Decimal?
  // What the courier actually bills the platform. Differs from the above once
  // discounts, COD fees and platform adjustments are applied.
  courierCharge Decimal?
  // Collectible amount handed to the rider.
  codAmount Decimal?
  // The courier's COD handling fee.
  codFee Decimal?
  // True while the price charged the customer came from a live provider quote
  // rather than a platform default. Controls settlement and refund behaviour.
  deliveryFeeVerified Boolean @default(false)

  // --- Booking state machine ---
  // See modules/logistics/bookingService. Independent of ShipmentStatus: a
  // shipment can be `delivered` while its booking state says BOOKED.
  bookingState  String    @default("pending")
  bookingAttemptCount Int @default(0)
  lastBookingError     String?
  lastBookingErrorCode String?
  lastBookedAt         DateTime?

  // --- Reconciliation bookkeeping ---
  lastReconciledAt DateTime?
  nextReconcileAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order     Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  seller    User                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  warehouse Warehouse?          @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  items     OrderShipmentItem[]
  events        ShipmentEvent[]
  bookingAttempts CourierBookingAttempt[]

  @@index([orderId, createdAt])
  @@index([sellerId, status, createdAt])
  @@index([warehouseId, status, createdAt])
  @@index([courierProvider, status, createdAt])
  @@index([bookingState, nextReconcileAt])
  @@index([merchantReference])
  // Every webhook and every reconciliation poll looks a consignment up by
  // tracking id. Without this, each of those is a sequential scan of the whole
  // shipments table.
  @@index([trackingId])
  @@unique([courierProvider, merchantReference])
  @@schema("public")
}

// Append-only audit trail of every meaningful shipment status change, from any
// source. This is what the admin/seller/customer timelines read instead of
// reconstructing history from mutable columns.
model ShipmentEvent {
  id             String   @id @default(cuid())
  shipmentId     String
  // Where the change came from.
  source         String
  provider       String?
  // The provider's raw status string, before normalization.
  externalStatus String?
  // The normalized status actually applied to the shipment.
  internalStatus String?
  // Provider-supplied event id, when one exists. Used for replay protection.
  eventId        String?
  occurredAt     DateTime
  processedAt    DateTime @default(now())
  note           String?
  // Non-identifying extra context only. Never store credentials or customer PII.
  metadata       Json?

  shipment OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, source, eventId])
  @@index([shipmentId, occurredAt])
  @@index([source, occurredAt])
  @@schema("public")
}

// One row per booking API call. Makes duplicate-booking investigations and
// retry decisions answerable without log spelunking.
model CourierBookingAttempt {
  id          String   @id @default(cuid())
  shipmentId  String
  provider    String
  attemptNumber Int
  // Idempotency key used for this attempt. Stable across retries.
  merchantReference String?
  startedAt   DateTime @default(now())
  completedAt DateTime?
  durationMs  Int?
  success     Boolean  @default(false)
  // A timed-out write that may have created a parcel is `uncertain`, not failed.
  outcome     String   @default("in_progress")
  errorCode   String?
  errorMessage String?
  httpStatus  Int?
  requestId   String?

  shipment OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId, attemptNumber])
  @@index([provider, startedAt])
  @@index([outcome, startedAt])
  @@schema("public")
}

// Webhook replay protection. One row per received delivery; a redelivery of an
// event id that already exists is acknowledged without reprocessing.
model WebhookDelivery {
  id           String   @id @default(cuid())
  provider     String
  eventId      String
  status       String
  externalShipmentId String?
  // How many times the provider sent this exact event.
  deliveryCount Int     @default(1)
  receivedAt   DateTime @default(now())
  processedAt  DateTime?
  // Outcome: processed | duplicate | ignored | failed
  outcome      String   @default("received")
  errorMessage String?

  @@unique([provider, eventId])
  @@index([provider, receivedAt])
  @@schema("public")
}

// Generic mapping from a LofiMart warehouse to a courier's own pickup point.
// Replaces provider-specific `Warehouse.pathaoStoreId`-style columns as the
// source of truth; adding a courier needs no new column on Warehouse.
model CourierStoreMapping {
  id          String   @id @default(cuid())
  provider    String
  warehouseId String
  // The courier's own id for this pickup point.
  externalStoreId String
  externalStoreName String?
  // Some couriers review new pickup points before use (Pathao does).
  status      String   @default("pending")
  isActive    Boolean  @default(true)
  // Provider ids for the pickup location, used for store creation and checks.
  cityId      Int?
  zoneId      Int?
  areaId      Int?
  verifiedAt  DateTime?
  lastError   String?
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([provider, warehouseId])
  @@unique([provider, externalStoreId])
  @@index([provider, status])
  @@schema("public")
}

model OrderShipmentItem {
  id          String   @id @default(cuid())
  shipmentId  String
  orderItemId String
  productId   String
  qty         Int      @default(1)
  price       Decimal
  createdAt   DateTime @default(now())

  shipment  OrderShipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([orderItemId])
  @@index([shipmentId, createdAt])
  @@index([productId])
  @@schema("public")
}

model Warehouse {
  id                            String   @id @default(cuid())
  name                          String
  tenantId                      String?
  address                       String
  city                          String
  state                         String?
  country                       String
  postalCode                    String
  phone                         String?
  email                         String?
  contactName                   String?
  secondaryContact              String?
  otpNumber                     String?
  // DEPRECATED: provider-specific location/store ids. Superseded by
  // CourierStoreMapping, which is keyed by `provider` so a new courier needs no
  // new column here. Retained (nullable, non-destructive) so existing rows keep
  // working and can be migrated; new code reads CourierStoreMapping first and
  // falls back to these only while a warehouse has no mapping row yet.
  pathaoStoreId                 Int?
  pathaoCityId                  Int?
  pathaoZoneId                  Int?
  pathaoAreaId                  Int?
  insideDhakaFee                Decimal?
  outsideDhakaFee               Decimal?
  insideDhakaEta                String?
  outsideDhakaEta               String?
  freeShippingThresholdOverride Decimal?
  maxItems                      Int?
  maxWeightKg                   Float?
  managerId                     String?
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt

  tenant             Tenant?             @relation(fields: [tenantId], references: [id])
  manager            User?               @relation("WarehouseManager", fields: [managerId], references: [id])
  inventoryItems     InventoryItem[]
  purchaseOrders     PurchaseOrder[]
  inventoryMovements InventoryMovement[]
  stockReservations  StockReservation[]
  shipments          OrderShipment[]
  courierStores      CourierStoreMapping[]

  @@schema("public")
}

model InventoryItem {
  id               String   @id @default(cuid())
  productId        String
  warehouseId      String
  quantity         Int      @default(0)
  reserved         Int      @default(0)
  reorderLevel     Int      @default(5)
  restockThreshold Int?
  updatedAt        DateTime @updatedAt
  createdAt        DateTime @default(now())

  product      Product             @relation(fields: [productId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  movements    InventoryMovement[]
  reservations StockReservation[]

  @@unique([productId, warehouseId])
  @@schema("public")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users              User[]
  products           Product[]
  orders             Order[]
  warehouses         Warehouse[]
  stores             Store[]
  memberships        TenantMembership[]
  settings           TenantSetting?
  walletTransactions WalletTransaction[]
  rewardLogs         RewardLog[]
  referralCodes      ReferralCode[]
  spinRewards        SpinReward[]
  spinHistory        SpinHistory[]
  missions           Mission[]
  notifications      UserNotification[]
  communityPosts     CommunityPost[]

  @@schema("public")
}

model Store {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  domain    String?  @unique
  currency  String   @default("USD")
  locale    String   @default("en")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@schema("public")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subcategories Subcategory[]

  @@schema("public")
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  name       String
  icon       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category         Category         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subsubcategories Subsubcategory[]

  @@schema("public")
}

model Subsubcategory {
  id            String   @id @default(cuid())
  subcategoryId String
  name          String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model EmailVerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@schema("public")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@schema("public")
}

model InventoryMovement {
  id              String   @id @default(cuid())
  inventoryItemId String
  productId       String
  warehouseId     String
  type            String
  quantityDelta   Int
  reason          String
  reference       String?
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([productId])
  @@schema("public")
}

model StockReservation {
  id              String    @id @default(cuid())
  productId       String
  warehouseId     String
  inventoryItemId String
  orderId         String?
  quantity        Int
  status          String    @default("reserved")
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  product       Product       @relation(fields: [productId], references: [id])
  warehouse     Warehouse     @relation(fields: [warehouseId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  order         Order?        @relation(fields: [orderId], references: [id])

  @@index([productId])
  @@index([orderId])
  @@index([status])
  @@schema("public")
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  warehouseId  String
  supplierName String
  status       String   @default("draft")
  currency     String   @default("USD")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  lines     PurchaseOrderLine[]

  @@index([warehouseId])
  @@index([status])
  @@schema("public")
}

model PurchaseOrderLine {
  id              String  @id @default(cuid())
  purchaseOrderId String
  productId       String
  quantity        Int
  unitCost        Decimal

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  product       Product       @relation(fields: [productId], references: [id])

  @@index([purchaseOrderId, productId])
  @@schema("public")
}

model PaymentTransaction {
  id             String        @id @default(cuid())
  provider       String
  paymentId      String        @unique
  orderId        String?
  customerId     String?
  amount         Decimal
  currency       String
  status         PaymentStatus
  idempotencyKey String        @unique
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  order    Order?   @relation(fields: [orderId], references: [id])
  customer User?    @relation("PaymentTransactions", fields: [customerId], references: [id])
