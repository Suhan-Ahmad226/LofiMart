{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "node scripts/ensure-root-app-dir.mjs && node scripts/next-sanitize-build.mjs && node scripts/next-heal-cache.mjs && cross-env NODE_ENV=development tsx server.ts",
    "build": "node scripts/ensure-root-app-dir.mjs && node scripts/next-sanitize-build.mjs && node scripts/next-heal-cache.mjs && npm run prisma:generate:safe && next build && tsc -p tsconfig.server.json && node scripts/fix-dist-imports.mjs",
    "build:clean": "npm run clean && npm run build",
    "start": "node scripts/ensure-root-app-dir.mjs && cross-env NODE_ENV=production node dist/server.js",
    "worker": "cross-env NODE_ENV=development tsx src/workers/index.ts",
    "start:worker": "cross-env NODE_ENV=production node dist/src/workers/index.js",
    "clean": "powershell -NoProfile -Command \"if (Test-Path .next) { Remove-Item -Recurse -Force .next -ErrorAction SilentlyContinue }; if (Test-Path .next-prod) { Remove-Item -Recurse -Force .next-prod -ErrorAction SilentlyContinue }; if (Test-Path dist) { Remove-Item -Recurse -Force dist -ErrorAction SilentlyContinue }\"",
    "setup:prod": "npm run clean && npm install && npm run build",
    "start:prod": "npm run setup:prod && npm run start",
    "preflight:prod": "node scripts/preflight-production.mjs",
    "telegram:webhook:set": "node scripts/telegram-set-webhook.mjs",
    "lint": "node scripts/ensure-root-app-dir.mjs && tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:generate:safe": "node scripts/prisma-generate-safe.mjs",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate": "npm run prisma:deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@google/genai": "^1.29.0",
    "@prisma/client": "^6.19.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/xr": "^6.6.29",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.104.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/three": "^0.183.1",
    "@vercel/speed-insights": "^2.0.0",
    "axios": "^1.13.6",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.61.0",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "framer-motion": "^12.36.0",
    "idb": "^8.0.3",
    "ioredis": "^5.8.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.5.4",
    "nodemailer": "^8.0.4",
    "prisma": "^6.19.3",
    "radix-ui": "^1.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "react-intersection-observer": "^10.0.3",
    "react-use": "^17.6.0",
    "react-webcam": "^7.2.0",
    "recharts": "^3.8.0",
    "shadcn": "^4.4.0",
    "stripe": "^21.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "three": "^0.183.2",
    "tw-animate-css": "^1.4.0",
    "uuid": "^13.0.0",
    "web-push": "^3.6.7",
    "workbox-window": "^7.4.0",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/recharts": "^1.8.29",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-cookie": "^3.0.6",
    "postcss": "^8.5.10"
  }
}
