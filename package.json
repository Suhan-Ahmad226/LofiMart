{
  "name": "lofimart",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <24"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:clean": "node scripts/prisma-clean.cjs",
    "dev": "cross-env NODE_ENV=development APP_ENV=development next dev",
    "build": "npm run clean && npm run prisma:clean && npx prisma generate && npx prisma migrate deploy && npx next build",
    "build:clean": "npm run clean && npm run build",
    "start": "cross-env NODE_ENV=production next start",
    "worker": "cross-env NODE_ENV=development APP_ENV=development tsx src/workers/index.ts",
    "start:worker": "cross-env NODE_ENV=production node dist/src/workers/index.js",
    "clean": "node scripts/clean.cjs",
    "lint": "eslint src/ --max-warnings 50",
    "lint:types": "tsc --noEmit -p tsconfig.lint.json",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "npx vitest run --config vitest.config.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate": "npm run prisma:deploy",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@prisma/client": "^6.19.3",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.116.0",
    "@tailwindcss/postcss": "^4.2.2",
    "bullmq": "^5.61.0",
    "cloudinary": "^2.9.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "framer-motion": "^12.36.0",
    "idb": "^8.0.3",
    "ioredis": "^5.8.1",
    "lucide-react": "^0.546.0",
    "next": "^15.5.18",
    "nodemailer": "^9.0.3",
    "prisma": "^6.19.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.1.14",
    "tw-animate-css": "^1.4.0",
    "web-push": "^3.6.7",
    "ws": "^8.18.0",
    "zod": "^4.3.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@next/bundle-analyzer": "^16.3.3",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/recharts": "^1.8.29",
    "@vitest/coverage-v8": "^3.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-cookie": "^3.0.6",
    "postcss": "^8.5.10"
  }
}
