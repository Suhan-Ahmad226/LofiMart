# ===========================================
# LofiMart Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env or any real secret to version control.
#
# Validated at runtime by src/lib/env.ts (zod). Required variables that are
# missing or malformed will abort server startup. In production additional
# checks run: HTTPS origins, no placeholder secrets, Supabase public auth,
# at least one email provider, and complete integration pairs.

# ===========================================
# Server
# ===========================================
PORT=3000
WS_PORT=3101
NODE_ENV=development
# development | staging | production
APP_ENV=development
LOG_LEVEL=debug
# Build-time bundle analyzer (next.config.ts): ANALYZE=true

# ===========================================
# URLs
# ===========================================
# Required. Base URL of the app; used for auth links, CORS, metadata.
FRONTEND_URL=http://localhost:3000
# Public, browser-safe site URL (SEO / metadata / robots / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Comma-separated additional allowed CORS origins. All must use HTTPS in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Public, client API base URL. Required to differentiate from prod on the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
# Public, browser WebSocket endpoint for live inventory updates. Falls back to a
# runtime-derived wss:// host when omitted.
NEXT_PUBLIC_INVENTORY_WS=ws://localhost:3101

# ===========================================
# Supabase (Auth + database)
# ===========================================
# Required in production (server + browser). Project URL and paired key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
# Alias accepted everywhere the publishable key is read; set either, not both.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Secret. Server-only admin client (identity/user management). Never expose.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_AUTH_WEBHOOK_SECRET=your-supabase-auth-webhook-secret

# ===========================================
# Database
# ===========================================
# Required. Prisma client connection (pooled connection string).
DATABASE_URL=postgresql://postgres:password@localhost:5432/lofimart
# Prisma migrations and direct/DDL connection (bypasses PgBouncer). Optional for
# runtime, strongly recommended in production. Read by prisma/schema.prisma.
DIRECT_URL=postgresql://postgres:password@localhost:5432/lofimart

# ===========================================
# Redis (+ BullMQ queues, sessions, rate limits, cache)
# ===========================================
# Required. ioredis connection string (redis://, rediss:// for TLS).
REDIS_URL=redis://localhost:6379
# Use TLS in production (rediss://) with a strong password.
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=1
REDIS_PREFIX=lofimart:
RATE_LIMIT_PREFIX=lofimart:rl:
QUEUE_PREFIX=lofimart:q:
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800

# ===========================================
# Queue / Workers
# ===========================================
QUEUE_DEFAULT_JOB_ATTEMPTS=5
QUEUE_DEFAULT_JOB_BACKOFF_MS=5000
# Reap interval (ms) for expired stock reservations in the worker.
STOCK_RESERVATION_REAP_MS=300000

# ===========================================
# Auth & Security (independent random secrets, 32+ chars each)
# ===========================================
# JWT secret for Telegram bot invoice signing. Not used for user auth.
JWT_SECRET=your-64-char-random-secret
# AES key for encrypting sensitive fields at rest (recovery codes, etc).
FIELD_ENCRYPTION_KEY=your-32-char-field-encryption-key

# ===========================================
# Email
# ===========================================
# Optional. Resend API key (one provider is required in production).
RESEND_API_KEY=re_your-key
# Optional. SMTP transport. DERIVES TLS MODE FROM THE PORT:
#   SMTP_PORT=465  -> implicit TLS (secure: true)
#   SMTP_PORT=587  -> STARTTLS (secure: false, requireTLS: true)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@lofimart.com
# Optional. From address for worker / notification mail and OTP fallback chain.
NOTIFY_FROM_EMAIL=noreply@lofimart.com

# ===========================================
# SMS
# ===========================================
# Declared in the environment schema but not consumed by any current code path.
SMS_PROVIDER=your-provider
SMS_API_KEY=your-api-key
SMS_SENDER_ID=your-sender-id

# ===========================================
# OTP (email + WhatsApp dual-channel delivery)
# ===========================================
# Email OTP uses SMTP/Resend above. WhatsApp OTP is sent via the Meta Graph API
# when the WhatsApp block below is configured; otherwise email is used.
WHATSAPP_PHONE_NUMBER_ID=your-whatsapp-number-id
WHATSAPP_API_TOKEN=your-whatsapp-api-token
# Optional. Template name; defaults to "otp".
WHATSAPP_TEMPLATE_NAME=otp
# Optional. Falls back to FACEBOOK_APP_ID when that is not set. Not part of the
# zod schema; read directly from process.env.
WHATSAPP_META_APP_ID=your-meta-app-id
# Echo the plain OTP pin back to the client. Defaults to only APP_ENV=development;
# set explicitly to "true" to enable the dev affordance anywhere (never on production).
# DEV_OTP=true

# ===========================================
# OAuth
# ===========================================
# Google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# Meta / Facebook Graph (Social Automation + OAuth)
# Canonical names. FACEBOOK_CLIENT_ID / FACEBOOK_CLIENT_SECRET are kept as
# drop-in aliases for older installations and must never be mixed with APP_*.
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret
# Must match exactly the "Valid OAuth Redirect URIs" configured in the Meta App.
FACEBOOK_REDIRECT_URI=http://localhost:3000/api/social-automation/accounts/oauth/callback

# ===========================================
# Media (Cloudinary)
# ===========================================
# Optional. Only used when all three are present. CLOUDINARY_URL is NOT read by the app.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ===========================================
# AI (social caption generation)
# ===========================================
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# Web Push (VAPID)
# ===========================================
# Optional; required as a pair for worker push delivery.
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
# Public; browser subscription key. Also exposed via /api/config/public.
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key

# ===========================================
# Analytics (public, browser-safe)
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# ===========================================
# Inventory
# ===========================================
LOW_STOCK_THRESHOLD=10

# ===========================================
# Telegram
# ===========================================
# Optional; enabled when token is present.
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# Payments - SSLCommerz
# ===========================================
# Optional; enabled when store id + password are present.
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
# Must be false before public production launch.
SSLCOMMERZ_IS_SANDBOX=true

# ===========================================
# Payments - bKash
# ===========================================
# Optional; enabled when all are present. Use sandbox URL in development.
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-username
BKASH_PASSWORD=your-password
BKASH_APP_KEY=your-app-key
BKASH_APP_SECRET=your-app-secret
BKASH_WEBHOOK_TOPIC_ARN=your-topic-arn

# ===========================================
# Courier - Pathao
# ===========================================
# All five are required together to enable direct API booking.
# Leave the whole block blank to run Pathao in manual mode.
#
# Base URL must be one of the two documented hosts (see
# src/features/courier/providers/pathao/pathaoConstants.ts). An undocumented
# host is rejected at startup rather than silently retried, because a wrong host
# means credentials are sent somewhere nobody audited.
#   production: https://api-hermes.pathao.com
#   sandbox:    https://courier-api-sandbox.pathao.com
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your-client-id
PATHAO_CLIENT_SECRET=your-client-secret
PATHAO_USERNAME=your-merchant-username
PATHAO_PASSWORD=your-merchant-password
# Optional. Overrides the orders endpoint. Leave blank unless Pathao gives you a
# different path for your account; a wrong value here sends parcels nowhere.
PATHAO_BOOKING_ENDPOINT=
# Optional. Shared secret Pathao sends on webhooks.
# Unset means webhook delivery stays disabled (fails closed).
PATHAO_WEBHOOK_TOKEN=
# Escape hatch. Set to exactly 1 to allow PATHAO_BASE_URL to point at a host that
# is not one of the two above. Disables the credential-host check, and startup
# validation reports it as an error in production. Leave unset.
PATHAO_ALLOW_CUSTOM_BASE_URL=

# ===========================================
# Docker Compose only (docker-compose.yml, NOT read by the app)
# ===========================================
# Required when running `docker compose up` (compose file fails without them).
POSTGRES_DB=lofimart
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password
# Required by the compose Redis container (requirepass).
REDIS_PASSWORD=your-redis-password
