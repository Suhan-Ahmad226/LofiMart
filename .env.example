PORT=3000
WS_PORT=3101
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# Public app URL
FRONTEND_URL=https://shop.example.com
CORS_ALLOWED_ORIGINS=https://shop.example.com,https://www.shop.example.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase PostgreSQL
# For IPv4-only networks, use the Supabase Session Pooler.
# Important: the pooler username must be `postgres.<project-ref>`, not just `postgres`.
# The connection limit values below help avoid local/session pool exhaustion.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public&connection_limit=1&pool_timeout=30
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_SUPABASE_DB_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public&connection_limit=1&pool_timeout=30

# Redis / queues / caching
REDIS_URL=redis://:strongpassword@redis:6379
REDIS_PREFIX=amarshop_prod
RATE_LIMIT_PREFIX=ratelimit
QUEUE_PREFIX=amarshop_prod
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800
QUEUE_DEFAULT_JOB_ATTEMPTS=5
QUEUE_DEFAULT_JOB_BACKOFF_MS=5000
LOW_STOCK_THRESHOLD=5

# Auth
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Payments
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# AI / Search
GEMINI_API_KEY=

# Media
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Email
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@shop.example.com
NOTIFY_FROM_EMAIL=admin@shop.example.com

# Optional SMS / OTP provider placeholders
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Optional SSLCommerz live credentials
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=false

# Optional bKash tokenized checkout
# Sandbox example: https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_WEBHOOK_TOPIC_ARN=

# Push notifications
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=

# Courier provider setup
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_BOOKING_ENDPOINT=/aladdin/api/v1/orders
PATHAO_WEBHOOK_TOKEN=
REDX_API_KEY=
REDX_SECRET_KEY=
REDX_BASE_URL=
REDX_BOOKING_ENDPOINT=/api/v1/merchant/parcels
REDX_TRACKING_ENDPOINT=/api/v1/merchant/parcels/{trackingId}
REDX_WEBHOOK_TOKEN=
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=

# Public runtime vars only
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INVENTORY_WS=wss://shop.example.com/inventory
