# ===========================================
# LofiMart Environment Configuration
# ===========================================
# Copy this file to .env and fill in values.
# NEVER commit .env to version control.

# ===========================================
# Server
# ===========================================
PORT=3000
WS_PORT=3101
APP_ENV=development
NODE_ENV=development
LOG_LEVEL=debug

# ===========================================
# URLs
# ===========================================
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_INVENTORY_WS=ws://localhost:3101

# ===========================================
# Supabase
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Database
# ===========================================
DATABASE_URL=postgresql://postgres:password@localhost:5432/lofimart
DIRECT_URL=postgresql://postgres:password@localhost:5432/lofimart

# ===========================================
# Redis
# ===========================================
REDIS_URL=redis://localhost:6379
UPSTASH_REDIS_REST_URL=https://your-upstash-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
REDIS_PREFIX=lofimart:
RATE_LIMIT_PREFIX=lofimart:rl:
QUEUE_PREFIX=lofimart:q:
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=86400

# ===========================================
# Queue
# ===========================================
QUEUE_DEFAULT_JOB_ATTEMPTS=3
QUEUE_DEFAULT_JOB_BACKOFF_MS=5000

# ===========================================
# Auth
# ===========================================
JWT_SECRET=your-64-char-random-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# ===========================================
# Stripe
# ===========================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_MCP_KEY=whsec_...

# ===========================================
# SSLCommerz
# ===========================================
SSLCOMMERZ_STORE_ID=your-store-id
SSLCOMMERZ_STORE_PASSWORD=your-store-password
SSLCOMMERZ_IS_SANDBOX=true

# ===========================================
# bKash
# ===========================================
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_USERNAME=your-username
BKASH_PASSWORD=your-password
BKASH_APP_KEY=your-app-key
BKASH_APP_SECRET=your-app-secret
BKASH_WEBHOOK_TOPIC_ARN=your-topic-arn

# ===========================================
# AI
# ===========================================
GEMINI_API_KEY=your-gemini-api-key

# ===========================================
# Cloudinary
# ===========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ===========================================
# Email
# ===========================================
RESEND_API_KEY=re_your-key
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@lofimart.com
NOTIFY_FROM_EMAIL=noreply@lofimart.com

# ===========================================
# SMS
# ===========================================
SMS_PROVIDER=your-provider
SMS_API_KEY=your-api-key
SMS_SENDER_ID=your-sender-id

# ===========================================
# Web Push
# ===========================================
WEB_PUSH_PUBLIC_KEY=your-vapid-public-key
WEB_PUSH_PRIVATE_KEY=your-vapid-private-key
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-vapid-public-key

# ===========================================
# Inventory
# ===========================================
LOW_STOCK_THRESHOLD=10

# ===========================================
# Analytics
# ===========================================
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-pixel-id

# ===========================================
# Telegram
# ===========================================
TELEGRAM_BOT_TOKEN=your-bot-token
TELEGRAM_BOT_USERNAME=your-bot-username
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# ===========================================
# Courier - Pathao
# ===========================================
PATHAO_BASE_URL=https://merchant-api-live.pathao.com
PATHAO_CLIENT_ID=your-client-id
PATHAO_CLIENT_SECRET=your-client-secret
PATHAO_USERNAME=your-username
PATHAO_PASSWORD=your-password
PATHAO_BOOKING_ENDPOINT=https://merchant-api-live.pathao.com/api/v1/orders
PATHAO_WEBHOOK_TOKEN=your-webhook-token

# ===========================================
# Courier - Steadfast
# ===========================================
STEADFAST_API_KEY=your-api-key
STEADFAST_SECRET_KEY=your-secret-key
STEADFAST_BASE_URL=https://portal.steadfast.com.bd
STEADFAST_WEBHOOK_TOKEN=your-webhook-token

# ===========================================
# Courier - RedX
# ===========================================
REDX_API_KEY=your-api-key
REDX_SECRET_KEY=your-secret-key
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_BOOKING_ENDPOINT=https://openapi.redx.com.bd/v1.0.0-beta/domain/courier/parcel
REDX_TRACKING_ENDPOINT=https://openapi.redx.com.bd/v1.0.0-beta/tracking
REDX_WEBHOOK_TOKEN=your-webhook-token
