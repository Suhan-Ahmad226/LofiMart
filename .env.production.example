PORT=3000
WS_PORT=3101
APP_ENV=production
NODE_ENV=production
LOG_LEVEL=info

# Public app URL
FRONTEND_URL=https://lofimart.vercel.app
NEXT_PUBLIC_SITE_URL=https://lofimart.vercel.app
CORS_ALLOWED_ORIGINS=https://lofimart.vercel.app,https://lofimart-suhan-ahmad.vercel.app

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Database
# Keep connection_limit/pool_timeout if you stay on the Supabase session pooler.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public&connection_limit=1&pool_timeout=30
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-1-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require&schema=public&connection_limit=1&pool_timeout=30

# Redis / queues / caching
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT
UPSTASH_REDIS_REST_URL=https://YOUR_UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
REDIS_PREFIX=lofimart_prod
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_COMMAND_TIMEOUT_MS=3000
REDIS_MAX_RETRIES_PER_REQUEST=1
RATE_LIMIT_PREFIX=ratelimit
QUEUE_PREFIX=lofimart_prod
CACHE_TTL_SECONDS=300
SESSION_TTL_SECONDS=604800
QUEUE_DEFAULT_JOB_ATTEMPTS=5
QUEUE_DEFAULT_JOB_BACKOFF_MS=5000
LOW_STOCK_THRESHOLD=5

# Auth
JWT_SECRET=replace-with-a-random-64-character-secret
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

# Telegram bot control panel
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_BOT_USERNAME=your_bot_username
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-telegram-webhook-secret

# Payments
STRIPE_SECRET_KEY=your-stripe-live-secret-key
STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe dashboard webhook endpoint: https://lofimart.vercel.app/api/payments/stripe/webhook

# Optional: SSLCommerz
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
SSLCOMMERZ_IS_SANDBOX=false

# Optional: bKash Tokenized Checkout
BKASH_BASE_URL=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_WEBHOOK_TOPIC_ARN=

# AI / Search
GEMINI_API_KEY=your-gemini-api-key

# Media
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
CLOUDINARY_URL=cloudinary://YOUR_API_KEY:YOUR_API_SECRET@YOUR_CLOUD_NAME

# Email
RESEND_API_KEY=your-resend-api-key
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-secret
SMTP_FROM=no-reply@your-domain.com
NOTIFY_FROM_EMAIL=no-reply@your-domain.com

# Optional SMS / OTP provider
SMS_PROVIDER=
SMS_API_KEY=
SMS_SENDER_ID=

# Push notifications
WEB_PUSH_PUBLIC_KEY=your-web-push-public-key
WEB_PUSH_PRIVATE_KEY=your-web-push-private-key
NEXT_PUBLIC_WEB_PUSH_PUBLIC_KEY=your-web-push-public-key

# Marketing analytics
# Leave blank to disable. Set these in Vercel Production Environment Variables.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# Public runtime vars
# Keep API base relative on Vercel so all browser requests hit the same live deployment.
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_INVENTORY_WS=wss://lofimart.vercel.app/inventory

# Courier: Pathao
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=your-pathao-client-id
PATHAO_CLIENT_SECRET=your-pathao-client-secret
PATHAO_USERNAME=your-pathao-username
PATHAO_PASSWORD=your-pathao-secret
PATHAO_BOOKING_ENDPOINT=/aladdin/api/v1/orders
PATHAO_WEBHOOK_TOKEN=your-pathao-webhook-token

# Courier: Steadfast
STEADFAST_API_KEY=your-steadfast-api-key
STEADFAST_SECRET_KEY=your-steadfast-secret-key
STEADFAST_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_WEBHOOK_TOKEN=your-steadfast-webhook-token

# Optional: RedX
REDX_API_KEY=
REDX_SECRET_KEY=
REDX_BASE_URL=
REDX_BOOKING_ENDPOINT=
REDX_TRACKING_ENDPOINT=
REDX_WEBHOOK_TOKEN=
